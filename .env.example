# PulsePoint — AI Family Health Network
# MED-AI Hackathon 2026 Configuration Template

# --- MANDATORY: Core AI Engines ---
# Primary LLM & Embeddings: Gemini 1.5 Flash (Required for Triage & RAG)
GOOGLE_API_KEY=your_gemini_api_key_here

# --- OPTIONAL: Fallbacks & Hosted Models ---
# Fallback LLMs: OpenRouter (Llama 3.1, Gemma 2, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face: For downloading fine-tuned LoRA weights or using hosted classifiers
HF_TOKEN=your_huggingface_token_here

# --- OPTIONAL: Input Layer ---
# Speech-to-Text: AssemblyAI (For voice symptom input)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# --- System Configuration ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Directory Mapping (Relative to Project Root) ---
DATA_DIR=data
MODELS_DIR=models
CONFIGS_DIR=configs
KNOWLEDGE_BASE_DIR=data/kb
