# PulsePoint — AI Family Health Network
# MED-AI Hackathon 2026 Configuration

# --- LLM API Keys ---
# Primary Model: Gemini 2.5 Flash
GOOGLE_API_KEY=your_gemini_api_key_here

# Fallback Models: OpenRouter (Llama 3.1, Gemma 2)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face (For Fine-tuned Llama 3.1 LoRA & Hosted Classifiers)
HF_TOKEN=your_huggingface_token_here

# --- Input Layer Keys ---
# STT Online: AssemblyAI
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# --- Environment ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Folders (Defaults) ---
DATA_DIR=data
MODELS_DIR=models
CONFIGS_DIR=configs
